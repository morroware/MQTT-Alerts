# =============================================================================
# MQTT-Alerts Configuration
# =============================================================================
# Copy this file to /etc/mqtt-alerts/mqtt-alerts.env and edit as needed.
# The installer does this automatically.
# =============================================================================

# ---- MQTT Broker ----
# Host and port of the Mosquitto broker (default: localhost:1883)
MQTT_HOST=localhost
MQTT_PORT=1883

# Leave blank for anonymous access (default for local installs)
MQTT_USERNAME=
MQTT_PASSWORD=

# Client ID for the alert service's MQTT connection
MQTT_CLIENT_ID=mqtt-alert-service

# ---- Slack Bot Token ----
# Create a Slack App at: https://api.slack.com/apps
# 1. Create New App > From Scratch
# 2. Go to "OAuth & Permissions"
# 3. Add Bot Token Scopes: chat:write, chat:write.public, channels:read
# 4. Install the app to your workspace
# 5. Copy the "Bot User OAuth Token" (starts with xoxb-)
SLACK_BOT_TOKEN=

# Default Slack channel for alerts (can be overridden per-rule in the UI)
SLACK_DEFAULT_CHANNEL=#alerts

# Maximum number of Slack alerts per minute (prevents flooding)
SLACK_RATE_LIMIT=10

# ---- Database ----
# Path to the SQLite database file
DB_PATH=/var/lib/mqtt-alerts/alerts.db

# ---- Web UI ----
# Host and port for the web interface
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ---- Data Retention ----
# Automatically delete old messages and alert logs
MESSAGE_RETENTION_DAYS=7
ALERT_LOG_RETENTION_DAYS=30

# ---- Logging ----
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
