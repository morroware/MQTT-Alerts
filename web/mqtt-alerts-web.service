[Unit]
Description=MQTT Alerts Web UI
Documentation=https://github.com/morroware/MQTT-Alerts
After=network.target mosquitto.service

[Service]
Type=simple
User=mqtt-alerts
Group=mqtt-alerts
EnvironmentFile=/etc/mqtt-alerts/mqtt-alerts.env
ExecStart=/opt/mqtt-alerts/venv/bin/uvicorn mqtt_alerts_web.main:app --host 0.0.0.0 --port 8080
WorkingDirectory=/opt/mqtt-alerts/web
Restart=on-failure
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mqtt-alerts
PrivateTmp=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mqtt-alerts-web

[Install]
WantedBy=multi-user.target
